# Copy to .dev.vars for local `wrangler dev`. In production every value here is a
# SECRET set with `wrangler secret put <NAME>` — none of them belong in wrangler.jsonc,
# because a plaintext `var` silently overrides a secret of the same name on deploy.

# ── RealtimeKit (Cloudflare Realtime) ─────────────────────────────────────────
# Create an API token with the "Realtime / Realtime Admin" permission at
# https://dash.cloudflare.com/profile/api-tokens, then create an app at
# https://dash.cloudflare.com/?to=/:account/realtime/kit — creating the app in the
# dashboard also creates the default presets this code expects.
CLOUDFLARE_ACCOUNT_ID=
REALTIMEKIT_APP_ID=
REALTIMEKIT_API_TOKEN=

# Overrides the production value in wrangler.jsonc for local dev. Without this,
# `npm run dev` serves a widget whose socket and call iframe point at the LIVE
# site — which mostly works, and is therefore a confusing way to test nothing.
PUBLIC_BASE_URL=http://localhost:8787

# ── Agent authentication ──────────────────────────────────────────────────────
# Mode "password" (default): each agent has an email + password (agents table;
# create with `node scripts/agent.mjs add`, or on the dashboard's Agents tab).
# Mode "access" puts Cloudflare Access in front of /host and trusts only a
# verified Access JWT. Prefer it in production. See README "Authentication".
HOST_AUTH_MODE=password
# Signs the session cookie. Any long random string; rotating it signs everyone out.
SESSION_SECRET=dev-only-not-a-real-secret
# The local seed (npm run db:seed) creates an admin you can sign in with:
#   email dev@example.com   password local-dev-password

# Only used when HOST_AUTH_MODE=access.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
# ALLOWED_HOST_EMAIL=you@example.com,colleague@example.com
